@@ -0,0 +1,281 @@
+/*	$OpenBSD$ */
+/*
+ * Copyright (c) 2026, Bob Beck <beck@obtuse.com>
+ *
+ * Permission to use, copy, modify, and/or distribute this software for any
+ * purpose with or without fee is hereby granted, provided that the above
+ * copyright notice and this permission notice appear in all copies.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES
+ * WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
+ * MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR ANY
+ * SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+ * WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN ACTION
+ * OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN
+ * CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+#include <pthread.h>
+#include <unistd.h>
+
+#include "crypto_rwlock.h"
+#include "test.h"
+
+#define NREADERS	4
+#define NWRITERS	8
+#define NWRITES		10000
+
+static struct crypto_rwlock static_lock = CRYPTO_RWLOCK_INITIALIZER;
+
+/*
+ * A lock with static storage is usable without a call to crypto_rwlock_init.
+ */
+static void
+test_static_initializer(struct test *t, const void *arg)
+{
+	if (!crypto_rwlock_rdlock(&static_lock)) {
+		test_errorf(t, "crypto_rwlock_rdlock failed");
+		return;
+	}
+	crypto_rwlock_rdunlock(&static_lock);
+
+	if (!crypto_rwlock_wrlock(&static_lock)) {
+		test_errorf(t, "crypto_rwlock_wrlock failed");
+		return;
+	}
+	crypto_rwlock_wrunlock(&static_lock);
+}
+
+struct readers_state {
+	struct crypto_rwlock lock;
+	pthread_barrier_t barrier;
+	int active;
+	int max_active;
+};
+
+static void *
+reader(void *arg)
+{
+	struct readers_state *st = arg;
+	int active;
+
+	if (!crypto_rwlock_rdlock(&st->lock))
+		return NULL;
+	active = __atomic_add_fetch(&st->active, 1, __ATOMIC_ACQ_REL);
+	for (;;) {
+		int max = __atomic_load_n(&st->max_active, __ATOMIC_ACQUIRE);
+
+		if (max >= active || __atomic_compare_exchange_n(
+		    &st->max_active, &max, active, 0, __ATOMIC_ACQ_REL,
+		    __ATOMIC_ACQUIRE))
+			break;
+	}
+	/* Every reader holds the lock here before any releases it. */
+	pthread_barrier_wait(&st->barrier);
+	__atomic_sub_fetch(&st->active, 1, __ATOMIC_ACQ_REL);
+	crypto_rwlock_rdunlock(&st->lock);
+
+	return NULL;
+}
+
+static void
+test_concurrent_readers(struct test *t, const void *arg)
+{
+	struct readers_state st = { 0 };
+	pthread_t threads[NREADERS];
+	int i;
+
+	if (!crypto_rwlock_init(&st.lock)) {
+		test_errorf(t, "crypto_rwlock_init failed");
+		return;
+	}
+	if (pthread_barrier_init(&st.barrier, NULL, NREADERS) != 0) {
+		test_errorf(t, "pthread_barrier_init failed");
+		goto done;
+	}
+	for (i = 0; i < NREADERS; i++) {
+		if (pthread_create(&threads[i], NULL, reader, &st) != 0) {
+			test_errorf(t, "pthread_create failed");
+			goto done;
+		}
+	}
+	for (i = 0; i < NREADERS; i++)
+		pthread_join(threads[i], NULL);
+
+	if (st.max_active != NREADERS)
+		test_errorf(t, "%d readers held the lock at once, want %d",
+		    st.max_active, NREADERS);
+
+	pthread_barrier_destroy(&st.barrier);
+ done:
+	crypto_rwlock_destroy(&st.lock);
+}
+
+struct writers_state {
+	struct crypto_rwlock lock;
+	int counter;
+};
+
+static void *
+writer(void *arg)
+{
+	struct writers_state *st = arg;
+	int i;
+
+	for (i = 0; i < NWRITES; i++) {
+		if (!crypto_rwlock_wrlock(&st->lock))
+			return NULL;
+		st->counter++;
+		crypto_rwlock_wrunlock(&st->lock);
+	}
+
+	return NULL;
+}
+
+static void
+test_exclusive_writers(struct test *t, const void *arg)
+{
+	struct writers_state st = { 0 };
+	pthread_t threads[NWRITERS];
+	int i;
+
+	if (!crypto_rwlock_init(&st.lock)) {
+		test_errorf(t, "crypto_rwlock_init failed");
+		return;
+	}
+	for (i = 0; i < NWRITERS; i++) {
+		if (pthread_create(&threads[i], NULL, writer, &st) != 0) {
+			test_errorf(t, "pthread_create failed");
+			goto done;
+		}
+	}
+	for (i = 0; i < NWRITERS; i++)
+		pthread_join(threads[i], NULL);
+
+	if (st.counter != NWRITERS * NWRITES)
+		test_errorf(t, "counter %d, want %d", st.counter,
+		    NWRITERS * NWRITES);
+
+ done:
+	crypto_rwlock_destroy(&st.lock);
+}
+
+struct preference_state {
+	struct crypto_rwlock lock;
+	int writer_done;
+	int reader_done;
+	int reader_saw_writer_done;
+};
+
+static void *
+waiting_writer(void *arg)
+{
+	struct preference_state *st = arg;
+
+	if (!crypto_rwlock_wrlock(&st->lock))
+		return NULL;
+	__atomic_store_n(&st->writer_done, 1, __ATOMIC_RELEASE);
+	crypto_rwlock_wrunlock(&st->lock);
+
+	return NULL;
+}
+
+static void *
+late_reader(void *arg)
+{
+	struct preference_state *st = arg;
+
+	if (!crypto_rwlock_rdlock(&st->lock))
+		return NULL;
+	st->reader_saw_writer_done =
+	    __atomic_load_n(&st->writer_done, __ATOMIC_ACQUIRE);
+	__atomic_store_n(&st->reader_done, 1, __ATOMIC_RELEASE);
+	crypto_rwlock_rdunlock(&st->lock);
+
+	return NULL;
+}
+
+static int
+writers_waiting(struct crypto_rwlock *lock)
+{
+	int n;
+
+	pthread_mutex_lock(&lock->mutex);
+	n = lock->writers_waiting;
+	pthread_mutex_unlock(&lock->mutex);
+
+	return n;
+}
+
+/*
+ * With a reader holding the lock and a writer waiting for it, a second
+ * reader must wait behind the writer rather than join the first reader.
+ */
+static void
+test_writer_preference(struct test *t, const void *arg)
+{
+	struct preference_state st = { 0 };
+	pthread_t writer_thread, reader_thread;
+	int i;
+
+	if (!crypto_rwlock_init(&st.lock)) {
+		test_errorf(t, "crypto_rwlock_init failed");
+		return;
+	}
+	if (!crypto_rwlock_rdlock(&st.lock)) {
+		test_errorf(t, "crypto_rwlock_rdlock failed");
+		goto done;
+	}
+	if (pthread_create(&writer_thread, NULL, waiting_writer, &st) != 0) {
+		test_errorf(t, "pthread_create failed");
+		crypto_rwlock_rdunlock(&st.lock);
+		goto done;
+	}
+	for (i = 0; i < 1000 && writers_waiting(&st.lock) == 0; i++)
+		usleep(1000);
+	if (writers_waiting(&st.lock) != 1) {
+		test_errorf(t, "writer is not waiting");
+		crypto_rwlock_rdunlock(&st.lock);
+		pthread_join(writer_thread, NULL);
+		goto done;
+	}
+	if (pthread_create(&reader_thread, NULL, late_reader, &st) != 0) {
+		test_errorf(t, "pthread_create failed");
+		crypto_rwlock_rdunlock(&st.lock);
+		pthread_join(writer_thread, NULL);
+		goto done;
+	}
+	usleep(50000);
+	if (__atomic_load_n(&st.reader_done, __ATOMIC_ACQUIRE))
+		test_errorf(t, "reader acquired the lock past a waiting "
+		    "writer");
+
+	crypto_rwlock_rdunlock(&st.lock);
+	pthread_join(writer_thread, NULL);
+	pthread_join(reader_thread, NULL);
+
+	if (!st.writer_done)
+		test_errorf(t, "writer did not run");
+	if (!st.reader_done)
+		test_errorf(t, "reader did not run");
+	if (!st.reader_saw_writer_done)
+		test_errorf(t, "reader ran before the waiting writer");
+
+ done:
+	crypto_rwlock_destroy(&st.lock);
+}
+
+int
+main(int argc, char **argv)
+{
+	struct test *t;
+
+	t = test_init();
+
+	test_run(t, "static initializer", test_static_initializer, NULL);
+	test_run(t, "concurrent readers", test_concurrent_readers, NULL);
+	test_run(t, "exclusive writers", test_exclusive_writers, NULL);
+	test_run(t, "writer preference", test_writer_preference, NULL);
+
+	return test_result(t);
+}
