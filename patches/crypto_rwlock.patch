+ * SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+ * WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN ACTION
+ * OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN
+ * CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+#include <pthread.h>
+
+#include "crypto_refcount.h"
+#include "test.h"
+
+#define NTHREADS	4
+#define NITERATIONS	10000
+
+static void
+test_refcount_values(struct test *t, const void *arg)
+{
+	int refcount = 1;
+	int ret;
+
+	if ((ret = crypto_refcount_up(&refcount)) != 2)
+		test_errorf(t, "up returned %d, want 2", ret);
+	if ((ret = crypto_refcount_up(&refcount)) != 3)
+		test_errorf(t, "up returned %d, want 3", ret);
+	if ((ret = crypto_refcount_down(&refcount)) != 2)
+		test_errorf(t, "down returned %d, want 2", ret);
+	if ((ret = crypto_refcount_down(&refcount)) != 1)
+		test_errorf(t, "down returned %d, want 1", ret);
+	if ((ret = crypto_refcount_down(&refcount)) != 0)
+		test_errorf(t, "down returned %d, want 0", ret);
+	if (refcount != 0)
+		test_errorf(t, "refcount %d, want 0", refcount);
+}
+
+static void *
+counter(void *arg)
+{
+	int *refcount = arg;
+	int i;
+
+	for (i = 0; i < NITERATIONS; i++)
+		crypto_refcount_up(refcount);
+	for (i = 0; i < NITERATIONS; i++)
+		crypto_refcount_down(refcount);
+
+	return NULL;
+}
+
+/*
+ * Every increment is matched by a decrement, so a count that is not back
+ * where it started is one that lost an update.
+ */
+static void
+test_concurrent_counts(struct test *t, const void *arg)
+{
+	int refcount = 1;
+	pthread_t threads[NTHREADS];
+	int i;
+
+	for (i = 0; i < NTHREADS; i++) {
+		if (pthread_create(&threads[i], NULL, counter, &refcount) != 0) {
+			test_errorf(t, "pthread_create failed");
+			break;
+		}
+	}
+	while (--i >= 0)
+		pthread_join(threads[i], NULL);
+
+	if (refcount != 1)
+		test_errorf(t, "refcount %d, want 1", refcount);
+}
+
+struct release_state {
+	int refcount;
+	int releases;
+};
+
+static void *
+releaser(void *arg)
+{
+	struct release_state *st = arg;
+
+	if (crypto_refcount_down(&st->refcount) == 0) {
+		crypto_refcount_fence();
+		crypto_refcount_up(&st->releases);
+	}
+
+	return NULL;
+}
+
+/*
+ * A count held by each thread and dropped once by each must reach zero for
+ * exactly one of them, since that is the thread that would free the object.
+ */
+static void
+test_single_release(struct test *t, const void *arg)
+{
+	struct release_state st = { .refcount = NTHREADS, .releases = 0 };
+	pthread_t threads[NTHREADS];
+	int i;
+
+	for (i = 0; i < NTHREADS; i++) {
+		if (pthread_create(&threads[i], NULL, releaser, &st) != 0) {
+			test_errorf(t, "pthread_create failed");
+			break;
+		}
+	}
+	while (--i >= 0)
+		pthread_join(threads[i], NULL);
+
+	if (st.releases != 1)
+		test_errorf(t, "%d threads saw zero, want 1", st.releases);
+}
+
+int
+main(int argc, char **argv)
+{
+	struct test *t;
+
+	t = test_init();
+
+	test_run(t, "refcount values", test_refcount_values, NULL);
+	test_run(t, "concurrent counts", test_concurrent_counts, NULL);
+	test_run(t, "single release", test_single_release, NULL);
