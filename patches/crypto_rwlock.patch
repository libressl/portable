+/*	$OpenBSD$ */
+/*
+ * Copyright (c) 2026, Bob Beck <beck@obtuse.com>
+ *
+ * Permission to use, copy, modify, and/or distribute this software for any
+ * purpose with or without fee is hereby granted, provided that the above
+ * copyright notice and this permission notice appear in all copies.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES
+ * WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
+ * MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR ANY
+ * SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+ * WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN ACTION
+ * OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN
+ * CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+#ifndef HEADER_CRYPTO_REFCOUNT_H
+#define HEADER_CRYPTO_REFCOUNT_H
+
+#include <sys/types.h>
+
+/*
+ * Atomic support detection, in preference order.  The __atomic builtins
+ * are clang and gcc 4.7 or later; the older __sync builtins cover base
+ * gcc 4.2.1 on alpha, hppa, m88k and sh, and are what sys/atomic.h is
+ * itself built on.  MSVC has neither and uses the Interlocked intrinsics.
+ *
+ * __has_builtin arrived in gcc 10, long after the builtins it is asked
+ * about here, so we fall back to a version test to catch the older
+ * stuff.
+ *
+ * At the moment, since anything we care about that would have C11
+ * style atomics also does the gcc/clang style builtins, nothing
+ * here attempts to use them yet, as today it seems to be yet another
+ * case for no benefit. That might change in the future.
+ */
+
+#if defined(__has_builtin)
+#if __has_builtin(__atomic_add_fetch)
+#define CRYPTO_ATOMIC_GCC
+#endif
+#endif
+
+#if !defined(CRYPTO_ATOMIC_GCC) && defined(__GNUC__)
+#if __GNUC__ > 4 || (__GNUC__ == 4 && __GNUC_MINOR__ >= 7)
+#define CRYPTO_ATOMIC_GCC
+#endif
+#endif
+
+#if !defined(CRYPTO_ATOMIC_GCC)
+#if defined(__has_builtin)
+#if __has_builtin(__sync_add_and_fetch)
+#define CRYPTO_ATOMIC_SYNC
+#endif
+#elif defined(__GNUC__)
+#if __GNUC__ > 4 || (__GNUC__ == 4 && __GNUC_MINOR__ >= 1)
+#define CRYPTO_ATOMIC_SYNC
+#endif
+#endif
+#endif
+
+#if !defined(CRYPTO_ATOMIC_GCC) && !defined(CRYPTO_ATOMIC_SYNC)
+#if defined(_MSC_VER)
+#include <intrin.h>
+#define CRYPTO_ATOMIC_INTERLOCKED
+#else
+#error "libressl requires atomic operations"
+#endif
+#endif
+
+__BEGIN_HIDDEN_DECLS
+
+static inline int
+crypto_refcount_up(int *refcount)
+{
+#if defined(CRYPTO_ATOMIC_GCC)
+	return __atomic_add_fetch(refcount, 1, __ATOMIC_RELAXED);
+#elif defined(CRYPTO_ATOMIC_SYNC)
+	return __sync_add_and_fetch(refcount, 1);
+#elif defined(CRYPTO_ATOMIC_INTERLOCKED)
+	return _InterlockedIncrement((volatile long *)refcount);
+#endif
+}
+
+static inline int
+crypto_refcount_down(int *refcount)
+{
+#if defined(CRYPTO_ATOMIC_GCC)
+	return __atomic_sub_fetch(refcount, 1, __ATOMIC_RELEASE);
+#elif defined(CRYPTO_ATOMIC_SYNC)
+	return __sync_sub_and_fetch(refcount, 1);
+#elif defined(CRYPTO_ATOMIC_INTERLOCKED)
+	return _InterlockedDecrement((volatile long *)refcount);
+#endif
+}
+
+/*
+ * Called by the thread that took the count to zero, before it tears the
+ * object down.  The __sync builtins and the Interlocked intrinsics are full
+ * barriers and need nothing here.
+ */
+static inline void
+crypto_refcount_fence(void)
+{
+#if defined(CRYPTO_ATOMIC_GCC)
+	__atomic_thread_fence(__ATOMIC_ACQUIRE);
+#endif
+}
+
+__END_HIDDEN_DECLS
+
+#endif /* HEADER_CRYPTO_REFCOUNT_H */
