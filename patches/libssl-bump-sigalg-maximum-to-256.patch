From 504e7ca512ffb1b67ac44878f7d73b52402466a5 Mon Sep 17 00:00:00 2001
From: bluhm <>
Date: Tue, 10 Nov 2026 21:32:07 +0000
Subject: [PATCH] libssl: bump sigalg maximum to 256

With PQ algorithms getting more widely deployed, the formerly generous cap
of 32 sigalgs has long been known to be too tight for a while. A couple of
years back jmatthew ran into interop issues with the oqs provider being
enabled on OmniOS by default. OpenSSL 4.1 now announcing 39 sigalgs, this
is becoming a real-world problem and is first and foremost protecting us
from seamless interop with other stacks.

To this end, introduce a helper shared between client and server to cap
the list size and a macro similar to the one we have for supported groups.

Thanks to DabeDotCom for reporting.
Fixes https://github.com/libressl/portable/issues/1446

from tb@; OK jsing@

this is errata/7.9/048_libressl.patch.sig
---
 ssl/ssl_tlsext.c | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git ssl/ssl_tlsext.c ssl/ssl_tlsext.c
index d879b3304..6a7cb0c27 100644
--- ssl/ssl_tlsext.c
+++ ssl/ssl_tlsext.c
@@ -1,4 +1,4 @@
-/* $OpenBSD: ssl_tlsext.c,v 1.159 2025/12/04 21:16:17 beck Exp $ */
+/* $OpenBSD: ssl_tlsext.c,v 1.159.2.1 2026/11/10 21:32:07 bluhm Exp $ */
 /*
  * Copyright (c) 2016, 2017, 2019 Joel Sing <jsing@openbsd.org>
  * Copyright (c) 2017 Doug Hogan <doug@openbsd.org>
@@ -33,7 +33,8 @@
 #include "ssl_tlsext.h"
 
 #define TLSEXT_TYPE_alpn TLSEXT_TYPE_application_layer_protocol_negotiation
-#define TLSEXT_MAX_SUPPORTED_GROUPS 64
+#define TLSEXT_MAX_SUPPORTED_GROUPS	64
+#define TLSEXT_MAX_SIGALGS		256
 
 /*
  * Supported Application-Layer Protocol Negotiation - RFC 7301
@@ -593,6 +594,16 @@ tlsext_sigalgs_client_build(SSL *s, uint16_t msg_type, CBB *cbb)
 	return 1;
 }
 
+static int
+tlsext_sigalgs_check_length(CBS *cbs)
+{
+	if (CBS_len(cbs) % 2 != 0)
+		return 0;
+	if (CBS_len(cbs) / 2 > TLSEXT_MAX_SIGALGS)
+		return 0;
+	return 1;
+}
+
 static int
 tlsext_sigalgs_server_process(SSL *s, uint16_t msg_type, CBS *cbs, int *alert)
 {
@@ -600,7 +611,7 @@ tlsext_sigalgs_server_process(SSL *s, uint16_t msg_type, CBS *cbs, int *alert)
 
 	if (!CBS_get_u16_length_prefixed(cbs, &sigalgs))
 		return 0;
-	if (CBS_len(&sigalgs) % 2 != 0 || CBS_len(&sigalgs) > 64)
+	if (!tlsext_sigalgs_check_length(&sigalgs))
 		return 0;
 	if (!CBS_stow(&sigalgs, &s->s3->hs.sigalgs, &s->s3->hs.sigalgs_len))
 		return 0;
@@ -640,7 +651,7 @@ tlsext_sigalgs_client_process(SSL *s, uint16_t msg_type, CBS *cbs, int *alert)
 
 	if (!CBS_get_u16_length_prefixed(cbs, &sigalgs))
 		return 0;
-	if (CBS_len(&sigalgs) % 2 != 0 || CBS_len(&sigalgs) > 64)
+	if (!tlsext_sigalgs_check_length(&sigalgs))
 		return 0;
 	if (!CBS_stow(&sigalgs, &s->s3->hs.sigalgs, &s->s3->hs.sigalgs_len))
 		return 0;
-- 
