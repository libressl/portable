+ * WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN ACTION
+ * OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN
+ * CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+#ifndef HEADER_CRYPTO_RWLOCK_H
+#define HEADER_CRYPTO_RWLOCK_H
+
+#include <pthread.h>
+
+__BEGIN_HIDDEN_DECLS
+
+/*
+ * A reader/writer lock built on the pthread mutex and condition variable
+ * that libc provides.  libcrypto links only against libc, and libc has no
+ * pthread_rwlock: that lives in librthread.
+ *
+ * Any number of readers may hold the lock at once; a writer holds it alone.
+ * A waiting writer blocks new readers, so readers cannot starve it.
+ */
+struct crypto_rwlock {
+	pthread_mutex_t mutex;
+	pthread_cond_t readers_cond;
+	pthread_cond_t writers_cond;
+	int readers;
+	int writers_waiting;
+	int writer;
+};
+
+#define CRYPTO_RWLOCK_INITIALIZER {					\
+	.mutex = PTHREAD_MUTEX_INITIALIZER,				\
+	.readers_cond = PTHREAD_COND_INITIALIZER,			\
+	.writers_cond = PTHREAD_COND_INITIALIZER,			\
+}
+
+int crypto_rwlock_init(struct crypto_rwlock *lock);
+void crypto_rwlock_destroy(struct crypto_rwlock *lock);
+
+int crypto_rwlock_rdlock(struct crypto_rwlock *lock);
+void crypto_rwlock_rdunlock(struct crypto_rwlock *lock);
+
+int crypto_rwlock_wrlock(struct crypto_rwlock *lock);
+void crypto_rwlock_wrunlock(struct crypto_rwlock *lock);
+
+__END_HIDDEN_DECLS
+
+#endif /* HEADER_CRYPTO_RWLOCK_H */
